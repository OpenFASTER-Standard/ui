{
  "name": "@openfaster-standard/shapes",
  "version": "0.1.0",
  "description": "OpenFASTER's shape-rendering engine -- React components that render SHACL shapes as UI, built on @openfaster-standard/ui.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OpenFASTER-Standard/ui.git",
    "directory": "packages/shapes"
  },
  "homepage": "https://github.com/OpenFASTER-Standard/ui",
  "bugs": "https://github.com/OpenFASTER-Standard/ui/issues",
  "keywords": ["openfaster", "react", "shacl", "rdf", "shapes"],
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json --emitDeclarationOnly --declaration --outDir dist",
    "prepublishOnly": "pnpm build",
    "dev": "tsup --watch",
    "test": "vitest run",
    "lint": "oxlint"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  },
  "dependencies": {
    "@openfaster-standard/ui": "workspace:*",
    "n3": "^2.7.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/n3": "^1.26.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.1",
    "oxlint": "^1.81.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
