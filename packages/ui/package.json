{
  "name": "@openfaster-standard/ui",
  "version": "0.4.1",
  "description": "OpenFASTER's shared React component library -- Base UI primitives styled with Tailwind, catalogued in Storybook.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OpenFASTER-Standard/ui.git",
    "directory": "packages/ui"
  },
  "homepage": "https://github.com/OpenFASTER-Standard/ui",
  "bugs": "https://github.com/OpenFASTER-Standard/ui/issues",
  "keywords": ["openfaster", "react", "components", "ui", "base-ui", "tailwind"],
  "sideEffects": ["**/*.css"],
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./style.css": "./dist/style.css",
    "./theme.css": "./dist/theme.css"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json --emitDeclarationOnly --declaration --outDir dist && tsup && tailwindcss -i ./src/index.css -o ./dist/style.css --minify && cp ./src/index.css ./dist/theme.css && node scripts/copy-fonts.mjs",
    "prepublishOnly": "pnpm build",
    "dev": "tsup --watch",
    "test": "vitest run",
    "lint": "oxlint",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/geist": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.48.0",
    "shadcn": "^4.21.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^3.2.7",
    "@storybook/addon-a11y": "8.5.1",
    "@storybook/addon-essentials": "8.5.1",
    "@storybook/addon-interactions": "8.5.1",
    "@storybook/addon-onboarding": "8.5.1",
    "@storybook/blocks": "8.5.1",
    "@storybook/react": "8.5.1",
    "@storybook/react-vite": "8.5.1",
    "@storybook/test": "8.5.1",
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.1",
    "oxlint": "^1.81.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "storybook": "8.5.1",
    "tailwindcss": "^4.3.3",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
